# API Security Configuration
API_KEY=test-api-key

# Contact Form Webhook Configuration
WEBHOOK_CONTACT_FORM=your-webhook-password-here

# Database Configuration (SQLite - file path is hardcoded in lib/api-db.ts)
# Database file is located at: data/db.sqlite3

# Next.js Configuration
NODE_ENV=development

# Optional: Production IP Whitelist (comma-separated).
# Add your production server IPs here for API access
# ALLOWED_IPS=192.168.1.100,10.0.0.50

# Optional: Production Origin Whitelist (comma-separated)
# Add your production domains here for API access
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Optional: Rate Limiting Configuration
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=100

# Optional: Database URL (if using external database instead of SQLite)
# DATABASE_URL=file:./data/db.sqlite3

# Optional: Next.js Standalone Mode (for Docker deployment)
# NEXT_STANDALONE=true

# Optional: Custom Server Configuration
# PORT=3000
# HOST=localhost